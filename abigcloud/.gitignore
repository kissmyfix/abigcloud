# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.*
!.env.example

# macOS-specific files
.DS_Store

# editor settings and droppings
.idea/
.vscode/
*.swp

# machine-written session recall, not a source. Also self-ignored by
# .remember/.gitignore; listed here too because this repo is public.
.remember/

# staging area for source material being brought in, never committed
tmp/

# private working memory, never published (this repo is public)
memory/

# editor droppings and scratch copies
*.bak
*.whoops
*.astro.index
