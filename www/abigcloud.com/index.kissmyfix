k */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"92a026b0-d27f-4141-9b72-ea7e3845ea9d\") format('woff2');\n  unicode-range: U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"7b50f9bf-c63c-4a1e-9177-0bf38f84c3b3\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"94cc16df-10e9-4547-a300-1b2f4088ed20\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"e2fd4e24-37cf-4aab-b4c7-3e934c7b986f\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"2b79751a-b1c8-45ce-967b-8e38bede482c\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"0c21b262-1b61-404f-af6d-0eabe8c017bb\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* greek */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"92a026b0-d27f-4141-9b72-ea7e3845ea9d\") format('woff2');\n  unicode-range: U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"7b50f9bf-c63c-4a1e-9177-0bf38f84c3b3\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"94cc16df-10e9-4547-a300-1b2f4088ed20\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"e2fd4e24-37cf-4aab-b4c7-3e934c7b986f\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n\n\n<style>\n  html, body { margin: 0; padding: 0; height: 100%; background: #0a0a0a; overflow: hidden; }\n  #root { position: absolute; inset: 0; }\n  .audio-prompt {\n    position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%);\n    background: #FFD23F; color: #3A2418;\n    font-family: \"Bricolage Grotesque\", system-ui, sans-serif; font-weight: 800;\n    font-size: 28px; padding: 18px 32px; border-radius: 16px;\n    border: 4px solid #3A2418; box-shadow: 6px 6px 0 #FF6B6B;\n    cursor: pointer; z-index: 10000;\n  }\n<\u002Fstyle>\n<\u002Fhead>\n<body>\n<div id=\"root\"><\u002Fdiv>\n\n<script src=\"ee3d2179-f2bb-4d1c-b099-bc948cd95f33\" integrity=\"sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L\" crossorigin=\"anonymous\"><\u002Fscript>\n<script src=\"c81f6017-5220-4413-bef3-5a3727f91e90\" integrity=\"sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm\" crossorigin=\"anonymous\"><\u002Fscript>\n<script src=\"35f61200-a351-4bc7-a0ab-a422255ab53f\" integrity=\"sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y\" crossorigin=\"anonymous\"><\u002Fscript>\n\n<script type=\"text/babel\" src=\"2ad158c0-95d0-4c02-9ac2-17f5eb52f38e\"><\u002Fscript>\n<script type=\"text/babel\" src=\"3c803b28-c307-4062-ad4c-e6600d257566\"><\u002Fscript>\n<script type=\"text/babel\" src=\"d0f2df50-efb9-43a3-b6ce-2020f9fdd22d\"><\u002Fscript>\n<script type=\"text/babel\" src=\"1417b8dc-f384-43c6-a711-ead5bf8adf08\"><\u002Fscript>\n\n<script type=\"text/babel\">\n  const TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{\n    \"mood\": \"chaotic\",\n    \"palette\": \"neon\",\n    \"cast\": \"mob\",\n    \"audio\": false\n  }/*EDITMODE-END*/;\n\n  // Audio bridge: hooks into the Stage's TimelineContext to read the playhead\n  // and keeps an <audio> element synced to it.\n  function AudioSync({ src, enabled }) {\n    const { time, playing } = useTimeline();\n    const audioRef = React.useRef(null);\n    const [armed, setArmed] = React.useState(false);\n\n    // Create audio element once\n    React.useEffect(() => {\n      const a = new Audio(src);\n      a.preload = 'auto';\n      a.volume = 0.7;\n      audioRef.current = a;\n      return () => { a.pause(); audioRef.current = null; };\n    }, [src]);\n\n    // Sync play/pause + seek to timeline\n    React.useEffect(() => {\n      const a = audioRef.current;\n      if (!a || !armed || !enabled) { if (a) a.pause(); return; }\n      // Resync if drifted\n      if (Math.abs(a.currentTime - time) > 0.25) {\n        try { a.currentTime = Math.min(time, a.duration || time); } catch {}\n      }\n      if (playing && a.paused) a.play().catch(()=>{});\n      if (!playing && !a.paused) a.pause();\n    }, [time, playing, armed, enabled]);\n\n    // Click-to-arm overlay (browsers block autoplay until user interaction)\n    if (!armed && enabled) {\n      return (\n        <div className=\"audio-prompt\" onClick={() => {\n          const a = audioRef.current;\n          if (a) { a.play().then(()=>{ a.pause(); setArmed(true); }).catch(()=>setArmed(true)); }\n          else setArmed(true);\n        }}>\n          ▶ Click to enable sound\n        <\u002Fdiv>\n      );\n    }\n    return null;\n  }\n\n  function GlobalTRelay({ children }) {\n    // Pulls timeline.time and forwards to PotatoShort as a prop so karaoke can render.\n    const { time } = useTimeline();\n    return children(time);\n  }\n\n  function App() {\n    const [t, setTweak] = useTweaks(TWEAK_DEFAULTS);\n    setPalette(t.palette);\n    const bg = (PALETTES[t.palette] || PALETTES.sunshine).cream;\n\n    return (\n      <>\n        <Stage width={1280} height={720} duration={24} background={bg} persistKey=\"potato-short\" autoplay={false}>\n          <GlobalTRelay>\n            {(globalT) => (\n              <PotatoShort mood={t.mood} cast={t.cast} globalT={globalT}\n                key={t.palette + ':' + t.mood + ':' + t.cast}/>\n            )}\n          <\u002FGlobalTRelay>\n          <AudioSync src={window.__resources?.potatoSong || \"potato-song.wav\"} enabled={t.audio}/>\n        <\u002FStage>\n        <TweaksPanel title=\"Tweaks\">\n          <TweakSection label=\"Vibe\"/>\n          <TweakRadio label=\"Mood\" value={t.mood}\n            options={['happy','chill','chaotic','dramatic']}\n            onChange={(v)=>setTweak('mood', v)}/>\n          <TweakSection label=\"Look\"/>\n          <TweakRadio label=\"Palette\" value={t.palette}\n            options={['sunshine','candy','retro','neon']}\n            onChange={(v)=>setTweak('palette', v)}/>\n          <TweakSection label=\"Cast\"/>\n          <TweakRadio label=\"Size\" value={t.cast}\n            options={['solo','duo','squad','mob']}\n            onChange={(v)=>setTweak('cast', v)}/>\n          <TweakSection label=\"Sound\"/>\n          <TweakToggle label=\"Music\" value={t.audio}\n            onChange={(v)=>setTweak('audio', v)}/>\n        <\u002FTweaksPanel>\n      <\u002F>\n    );\n  }\n  ReactDOM.createRoot(document.getElementById('root')).render(<App/>);\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>