---
import defaultBanner from '../../assets/banners/home-banner.jpg';
import defaultBannerNarrow from '../../assets/banners/home-banner-narrow.jpg';
import Banner from '../components/Banner.astro';
import BaseHead from '../components/BaseHead.astro';
import BackToTop from '../components/BackToTop.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	draft?: boolean;
	heroImage?: ImageMetadata;
	heroImageNarrow?: ImageMetadata;
}

const { title, description, pubDate, updatedDate, draft, heroImage, heroImageNarrow } =
	Astro.props;

/* Pages without their own hero borrow the landing banner, so no page opens
   bare. Set heroImage in frontmatter to replace it. */
const bannerWide = heroImage ?? defaultBanner;
const bannerNarrow = heroImage ? heroImageNarrow : defaultBannerNarrow;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<Banner wide={bannerWide} narrow={bannerNarrow} />
		<main>
			<article>
				<div class="prose">
					<div class="title">
						{draft && <p class="draft-flag">Working draft. Facts still being verified.</p>}
						{
							(pubDate || updatedDate) && (
								<div class="date">
									{pubDate && <FormattedDate date={pubDate} />}
									{updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)}
								</div>
							)
						}
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<BackToTop />
	</body>
</html>

<style>
	/* main already sets the column width and gutters. */
	.prose {
		color: var(--ink2);
	}
	.title {
		margin-bottom: 1em;
		padding: 1em 0;
		line-height: 1.1;
	}
	.title h1 {
		margin: 0 0 0.5em 0;
	}
	.date {
		margin-bottom: 0.5em;
		color: var(--ink3);
		font-size: 0.8em;
	}
	.last-updated-on {
		font-style: italic;
	}
	.draft-flag {
		display: inline-block;
		margin: 0 0 1em 0;
		padding: 0.35em 0.9em;
		border: 1px solid var(--border2);
		border-radius: 999px;
		font-size: 0.7em;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink3);
	}
</style>
