---
import { getImage } from 'astro:assets';

// A wide cinematic crop turns into an unreadable sliver on a phone, so pages
// may supply a second, taller crop of the same scene. That is art direction,
// which <Image> does not do: it changes pixel count, not composition.
//
// Both crops are locked to one shape site-wide. The banner used to take its
// height from whatever the image happened to be, so clicking from a 2000x334
// banner to a 2000x500 one moved the whole page down. Every banner now renders
// at the same height whether or not its file cooperates.
const WIDE = { w: 2000, h: 334 };
const NARROW = { w: 1000, h: 667 };

interface Props {
	wide: ImageMetadata;
	narrow?: ImageMetadata;
}

const { wide, narrow } = Astro.props;

// object-fit would trim an off-spec file without a word. Say it out loud at
// build time instead, so a new banner gets fixed in the crop, not in the CSS.
const offSpec = (img: ImageMetadata, w: number, h: number) =>
	Math.abs(img.width / img.height - w / h) > 0.01;

if (offSpec(wide, WIDE.w, WIDE.h))
	console.warn(
		`[banner] ${wide.src} is ${wide.width}x${wide.height}, not ${WIDE.w}x${WIDE.h}. Cropping to fit.`
	);
if (!narrow)
	console.warn(
		`[banner] ${wide.src} has no ${NARROW.w}x${NARROW.h} narrow crop. Phones will get the wide crop squeezed into the same box.`
	);
else if (offSpec(narrow, NARROW.w, NARROW.h))
	console.warn(
		`[banner] ${narrow.src} is ${narrow.width}x${narrow.height}, not ${NARROW.w}x${NARROW.h}. Cropping to fit.`
	);

const wideImg = await getImage({ src: wide, widths: [800, 1200, 1600, 2000], format: 'webp' });
const narrowImg = narrow
	? await getImage({ src: narrow, widths: [500, 750, 1000], format: 'webp' })
	: null;
---

<div
	class="banner"
	style={`--ratio-wide:${WIDE.w} / ${WIDE.h};--ratio-narrow:${NARROW.w} / ${NARROW.h}`}
>
	<picture>
		{
			narrowImg && (
				<source
					media="(max-width: 700px)"
					srcset={narrowImg.srcSet.attribute}
					sizes="100vw"
					type="image/webp"
				/>
			)
		}
		<source srcset={wideImg.srcSet.attribute} sizes="100vw" type="image/webp" />
		<img src={wideImg.src} alt="" loading="eager" fetchpriority="high" decoding="async" />
	</picture>
</div>

<style>
	.banner {
		position: relative;
		z-index: 2;
		width: 100%;
		line-height: 0;
		/* Slide up under the header so the image starts at the top of the page
		   and the nav rides on it. --header-h-actual is measured by the header's
		   own script; the token is the fallback before that runs. */
		margin-top: calc(-1 * var(--header-h-actual, var(--header-h)));
	}
	.banner img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0;
		/* Reserves the box before the image arrives, so nothing jumps. */
		aspect-ratio: var(--ratio-wide);
		/* The box is the authority now, not the file: an off-spec banner gets
		   trimmed rather than pushing the page down. */
		object-fit: cover;
	}
	@media (max-width: 700px) {
		.banner img {
			aspect-ratio: var(--ratio-narrow);
		}
	}
	/* The fade does not stop at the bottom of the image. It carries on past it,
	   over whatever the page puts next, so content rising up under the banner
	   thins away into it rather than stopping at an edge. */
	.banner::before {
		content: '';
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		height: var(--banner-spill, 150px);
		pointer-events: none;
		z-index: 1;
		background: linear-gradient(
			to bottom,
			var(--bg) 0%,
			color-mix(in srgb, var(--bg) 92%, transparent) 22%,
			color-mix(in srgb, var(--bg) 72%, transparent) 42%,
			color-mix(in srgb, var(--bg) 45%, transparent) 62%,
			color-mix(in srgb, var(--bg) 20%, transparent) 80%,
			rgba(0, 0, 0, 0) 100%
		);
	}

	/* Fades the image into the page so there is no hard seam between them. */
	.banner::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 0) var(--banner-fade-bottom),
			var(--bg) 100%
		);
	}
</style>
