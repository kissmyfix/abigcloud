---
// Flips between light and dark and remembers the choice. With nothing saved the
// page follows the browser's preference, which is what the CSS does by default.
---

<button id="theme-toggle" type="button" aria-label="Toggle light and dark theme">
	<svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
		<circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
		<g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
			<line x1="12" y1="2" x2="12" y2="4.6"></line>
			<line x1="12" y1="19.4" x2="12" y2="22"></line>
			<line x1="2" y1="12" x2="4.6" y2="12"></line>
			<line x1="19.4" y1="12" x2="22" y2="12"></line>
			<line x1="4.9" y1="4.9" x2="6.8" y2="6.8"></line>
			<line x1="17.2" y1="17.2" x2="19.1" y2="19.1"></line>
			<line x1="4.9" y1="19.1" x2="6.8" y2="17.2"></line>
			<line x1="17.2" y1="6.8" x2="19.1" y2="4.9"></line>
		</g>
	</svg>
	<svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
		<path
			d="M20 14.2A8.2 8.2 0 0 1 9.8 4 8.4 8.4 0 1 0 20 14.2Z"
			fill="currentColor"
		></path>
	</svg>
</button>

<style>
	button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: transparent;
		color: var(--ink3);
		cursor: pointer;
		transition:
			color 0.15s,
			border-color 0.15s;
	}
	@media (hover: hover) {
		button:hover {
			color: var(--accent);
			border-color: var(--accent);
		}
	}
	/* Show the icon for the theme you would switch TO. */
	.moon {
		display: none;
	}
	:global(:root[data-theme='dark']) .sun,
	:global(:root[data-theme='light']) .moon {
		display: none;
	}
	:global(:root[data-theme='dark']) .moon,
	:global(:root[data-theme='light']) .sun {
		display: block;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .sun {
			display: none;
		}
		:global(:root:not([data-theme='light'])) .moon {
			display: block;
		}
	}
</style>

<script is:inline>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const root = document.documentElement;
		const current =
			root.dataset.theme ||
			(matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		const next = current === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		localStorage.setItem('theme', next);
	});
</script>
