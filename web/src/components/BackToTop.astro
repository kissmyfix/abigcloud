---
// Appears once you have scrolled a screen or so, and returns you to the top.
---

<button id="back-to-top" type="button" aria-label="Back to top">
	<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
		<path
			d="M12 19V6M12 6l-6 6M12 6l6 6"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
	</svg>
	<span>Top</span>
</button>

<style>
	button {
		/* Centred, sitting just right of the midline with #toc-button to its
		   left. The bottom-right corner is where dismissible page furniture
		   lives -- chat widgets, cookie notices -- and readers have learned not
		   to look there, so a reader who never went hunting never found these.
		   Centred, they read as part of the page. Brandon's call, 2026-08-20.
		   The safe-area inset keeps them clear of the iOS home indicator. */
		position: fixed;
		left: 50%;
		bottom: calc(var(--gutter) + var(--footer-lift, 0px) + env(safe-area-inset-bottom, 0px));
		z-index: 40;
		display: flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.6em 0.9em;
		border: 1px solid var(--border2);
		border-radius: 999px;
		background: var(--bg2);
		color: var(--ink2);
		font-family: var(--font-sans);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		cursor: pointer;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
		opacity: 0;
		visibility: hidden;
		transform: translate(6px, 8px);
		transition:
			opacity 0.2s,
			transform 0.2s,
			visibility 0.2s,
			color 0.15s,
			border-color 0.15s;
	}
	button.visible {
		opacity: 1;
		visibility: visible;
		transform: translate(6px, 0);
	}
	@media (hover: hover) {
		button:hover {
			color: var(--accent);
			border-color: var(--accent);
		}
	}
	@media (max-width: 720px) {
		button span {
			display: none;
		}
		button {
			padding: 0.7em;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		button {
			transition: opacity 0.2s, visibility 0.2s;
		}
	}
</style>

<script is:inline>
	(() => {
		const btn = document.getElementById('back-to-top');
		if (!btn) return;
		const sync = () => btn.classList.toggle('visible', window.scrollY > 600);
		sync();
		addEventListener('scroll', sync, { passive: true });
		btn.addEventListener('click', () => {
			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
			window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
		});
	})();
</script>
