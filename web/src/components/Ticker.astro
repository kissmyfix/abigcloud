---
/*
  The headline ticker.

  Each entry is a published headline and our corrected version, written as a diff:
  the `−` line is theirs, the `+` line is ours. Only the words that differ carry
  colour, because the whole point of the diff form is to show what changed.

  A fixed-height viewport holds a roll that is translated upward as new lines are
  written, so the newest line sits at the bottom and older ones drift up through a
  fade. The viewport never changes size, so nothing else on the page moves.

  The first PRELOAD pairs are rendered at build time, already finished, so the
  ticker is full of readable content the instant the page paints. The script picks
  up from there and keeps going.

  Pairs live in src/data/ticker.json. Adding, editing or removing one is an edit to
  that file alone.
*/
import pairs from '../data/ticker.json';

const PRELOAD = 4;
const preloaded = pairs.slice(0, PRELOAD);
const rest = pairs.slice(PRELOAD);
---

<section class="ticker" aria-label="Headlines, corrected">
	<div class="ticker-viewport" id="t-viewport">
		<div class="ticker-roll" id="t-roll">
			{preloaded.map((p) => (
				<>
					<div class="t-line t-minus">
						<span class="t-marker">&minus;</span>
						<span class="t-text">
							{p.minus.map((seg) =>
								typeof seg === 'string'
									? seg
									: <span class="tw-red hl">{seg.r ?? seg.g}</span>
							)}
						</span>
					</div>
					<div class="t-line t-plus">
						<span class="t-marker">+</span>
						<span class="t-text">
							{p.plus.map((seg) =>
								typeof seg === 'string'
									? seg
									: <span class="tw-green hl">{seg.g ?? seg.r}</span>
							)}
						</span>
					</div>
					<div class="t-line t-blank"></div>
				</>
			))}
		</div>
	</div>
</section>

<script is:inline define:vars={{ rest, all: pairs }}>
	(() => {
		const roll = document.getElementById('t-roll');
		const vp = document.getElementById('t-viewport');
		if (!roll || !vp) return;

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const CHAR = 52;        // per-character typing delay
		const MAX_LINES = 45;   // trim off the top so the roll cannot grow forever

		const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

		// Slide the whole roll up so the newest line stays at the bottom edge. The
		// transition on .ticker-roll is what turns this into a drift.
		function scrollRoll() {
			const over = roll.scrollHeight - vp.offsetHeight;
			roll.style.transform = over > 0 ? `translateY(-${over}px)` : '';
		}
		scrollRoll();

		function addLine(cls) {
			const d = document.createElement('div');
			d.className = 't-line ' + cls;
			roll.appendChild(d);
			while (roll.children.length > MAX_LINES) roll.firstElementChild.remove();
			scrollRoll();
			return d;
		}

		async function typeLine(mark, cls, segs, tone) {
			const line = addLine(cls);

			const marker = document.createElement('span');
			marker.className = 't-marker';
			marker.textContent = mark;

			const text = document.createElement('span');
			text.className = 't-text';

			const cursor = document.createElement('span');
			cursor.className = 't-cursor blinking';
			text.appendChild(cursor);

			line.append(marker, text);
			scrollRoll();

			const changed = [];
			for (const seg of segs) {
				const plain = typeof seg === 'string';
				const body = plain ? seg : (seg.r ?? seg.g);
				let node;
				if (plain) {
					node = document.createTextNode('');
				} else {
					node = document.createElement('span');
					node.className = tone;
					changed.push(node);
				}
				text.insertBefore(node, cursor);

				if (reduced) {
					node.textContent = body;
					continue;
				}
				for (const ch of body) {
					node.textContent += ch;
					scrollRoll();
					await sleep(ch === ' ' ? CHAR * 0.6 : CHAR);
				}
			}
			return { cursor, changed };
		}

		// Backgrounds arrive after the line is written, left to right, pulling the eye
		// back across the words that changed.
		async function sweep(changed) {
			for (const span of changed) {
				await sleep(reduced ? 0 : span.textContent.length * CHAR * 0.5);
				span.classList.add('hl');
				await sleep(reduced ? 0 : 90);
			}
		}

		async function retire(cursor) {
			cursor.classList.remove('blinking');
			await sleep(reduced ? 0 : 140);
			cursor.remove();
		}

		async function runPair(entry) {
			const minus = await typeLine('−', 't-minus', entry.minus, 'tw-red');
			await sleep(reduced ? 0 : 280);
			await sweep(minus.changed);
			await retire(minus.cursor);
			await sleep(reduced ? 200 : 850);

			const plus = await typeLine('+', 't-plus', entry.plus, 'tw-green');
			await sleep(reduced ? 0 : 280);
			await sweep(plus.changed);
			await retire(plus.cursor);

			addLine('t-blank');
			await sleep(reduced ? 900 : 3600);
		}

		(async () => {
			await sleep(1400);
			// Work through the ones not already on screen, then the whole set forever.
			for (const entry of rest) await runPair(entry);
			for (let i = 0; ; i++) await runPair(all[i % all.length]);
		})();
	})();
</script>

<style>
	.ticker {
		width: 100%;
		margin: 0 0 2.6em;
	}

	.ticker-viewport {
		position: relative;
		width: 100%;
		height: 340px;
		overflow: hidden;
	}

	/* Lines dissolve into the page as they leave the top. */
	.ticker-viewport::after {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 120px;
		background: linear-gradient(to bottom, var(--bg) 0%, transparent 100%);
		pointer-events: none;
		z-index: 3;
	}

	.ticker-roll {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		transition: transform 0.6s ease;
	}

	.t-line {
		display: flex;
		align-items: baseline;
		min-height: 30px;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 14.5px;
		line-height: 1.6;
		flex-shrink: 0;
	}

	.t-marker {
		width: 26px;
		min-width: 26px;
		padding-right: 8px;
		text-align: right;
		font-size: 14px;
		font-weight: 700;
	}
	.t-minus .t-marker { color: var(--accent); }
	.t-plus  .t-marker { color: var(--teal); }

	.t-text {
		flex: 1;
		color: var(--ink2);
		overflow-wrap: anywhere;
	}

	.t-blank { min-height: 20px; }

	/* Only the changed words carry colour. */
	.tw-red,
	.tw-green {
		border-radius: 2px;
		padding: 0 3px;
		font-weight: 600;
		background: transparent;
		transition: background 0.3s ease;
	}
	.tw-red   { color: var(--accent); }
	.tw-green { color: var(--teal); }
	.tw-red.hl   { background: var(--red-bg); }
	.tw-green.hl { background: var(--green-bg); }

	.t-cursor {
		display: inline-block;
		width: 8px;
		height: 1em;
		margin-left: 1px;
		vertical-align: -0.1em;
		background: var(--ink3);
	}
	.t-cursor.blinking { animation: tcblink 0.65s step-end infinite; }
	@keyframes tcblink {
		0%, 100% { opacity: 1; }
		50%      { opacity: 0; }
	}

	@media (max-width: 560px) {
		.ticker-viewport { height: 320px; }
		.t-line { font-size: 13px; }
		.t-marker { width: 20px; min-width: 20px; padding-right: 6px; }
	}

	@media (prefers-reduced-motion: reduce) {
		.ticker-roll { transition: none; }
		.t-cursor.blinking { animation: none; }
	}
</style>
