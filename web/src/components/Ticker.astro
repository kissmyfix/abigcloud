---
/*
  The headline ticker.

  Each entry is a published headline and our corrected version, written as a diff:
  the `−` line is theirs, the `+` line is ours. Only the words that differ carry
  colour, because the whole point of the diff form is to show what changed.

  A fixed-height viewport holds a roll that is translated upward as new lines are
  written, so the newest line sits at the bottom and older ones drift up through a
  fade. The viewport never changes size, so nothing else on the page moves.

  The first PRELOAD pairs are rendered at build time, already finished, so the
  ticker is full of readable content the instant the page paints. The script picks
  up from there and keeps going.

  Pairs live in src/data/ticker.json. Adding, editing or removing one is an edit to
  that file alone.
*/
import pairs from '../data/ticker.json';

const PRELOAD = 4;
const preloaded = pairs.slice(0, PRELOAD);
const rest = pairs.slice(PRELOAD);
---

<section class="ticker" aria-label="Headlines, corrected">
	<button
		type="button"
		class="t-what"
		id="t-what"
		aria-expanded="false"
		aria-controls="t-explainer"
	>
		What is this?
	</button>

	<div class="t-explainer" id="t-explainer" role="note" hidden>
		<p>Every top line is a real headline, published by a real newsroom.</p>
		<p>
			Under it is the same story told straight, rewritten using only what that
			article already says further down. Nothing is added from anywhere else.
		</p>
		<p>
			Read it as a diff. Orange is the word that was chosen. Teal is what the
			reporting underneath it actually supports.
		</p>
	</div>

	<div class="ticker-viewport" id="t-viewport">
		<div class="ticker-roll" id="t-roll">
			{preloaded.map((p) => (
				<>
					<div class="t-line t-minus">
						<span class="t-marker">&minus;</span>
						<span class="t-text">
							{p.minus.map((seg) =>
								typeof seg === 'string'
									? seg
									: <span class="tw-red hl">{seg.r ?? seg.g}</span>
							)}
						</span>
					</div>
					<div class="t-line t-plus">
						<span class="t-marker">+</span>
						<span class="t-text">
							{p.plus.map((seg) =>
								typeof seg === 'string'
									? seg
									: <span class="tw-green hl">{seg.g ?? seg.r}</span>
							)}
						</span>
					</div>
					<div class="t-line t-blank"></div>
				</>
			))}
		</div>
	</div>
</section>

<script is:inline define:vars={{ rest, all: pairs }}>
	(() => {
		const roll = document.getElementById('t-roll');
		const vp = document.getElementById('t-viewport');
		if (!roll || !vp) return;

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const CHAR = 52;        // per-character typing delay
		const MAX_LINES = 45;   // trim off the top so the roll cannot grow forever

		let paused = false;
		/* Typing halts while the explainer is open, so nothing moves under someone
		   who is reading it. */
		const sleep = async (ms) => {
			await new Promise((r) => setTimeout(r, ms));
			while (paused) await new Promise((r) => setTimeout(r, 120));
		};

		const what = document.getElementById('t-what');
		const panel = document.getElementById('t-explainer');
		if (what && panel) {
			const show = (open) => {
				paused = open;
				panel.hidden = !open;
				what.setAttribute('aria-expanded', String(open));
				document.querySelector('.ticker').classList.toggle('explaining', open);
			};
			what.addEventListener('mouseenter', () => show(true));
			what.addEventListener('focus', () => show(true));
			what.addEventListener('click', (e) => {
				e.preventDefault();
				show(panel.hidden);
			});
			const leave = (e) => {
				if (!e.relatedTarget || !e.relatedTarget.closest?.('.ticker')) show(false);
			};
			what.addEventListener('mouseleave', leave);
			panel.addEventListener('mouseleave', leave);
			what.addEventListener('blur', () => show(false));
			addEventListener('keydown', (e) => e.key === 'Escape' && show(false));
		}

		// Slide the whole roll up so the newest line stays at the bottom edge. The
		// transition on .ticker-roll is what turns this into a drift.
		function scrollRoll() {
			const over = roll.scrollHeight - vp.offsetHeight;
			roll.style.transform = over > 0 ? `translateY(-${over}px)` : '';
		}
		scrollRoll();

		function addLine(cls) {
			const d = document.createElement('div');
			d.className = 't-line ' + cls;
			roll.appendChild(d);
			while (roll.children.length > MAX_LINES) roll.firstElementChild.remove();
			scrollRoll();
			return d;
		}

		async function typeLine(mark, cls, segs, tone) {
			const line = addLine(cls);

			const marker = document.createElement('span');
			marker.className = 't-marker';
			marker.textContent = mark;

			const text = document.createElement('span');
			text.className = 't-text';

			const cursor = document.createElement('span');
			cursor.className = 't-cursor blinking';
			text.appendChild(cursor);

			line.append(marker, text);
			scrollRoll();

			const changed = [];
			for (const seg of segs) {
				const plain = typeof seg === 'string';
				const body = plain ? seg : (seg.r ?? seg.g);
				let node;
				if (plain) {
					node = document.createTextNode('');
				} else {
					node = document.createElement('span');
					node.className = tone;
					changed.push(node);
				}
				text.insertBefore(node, cursor);

				if (reduced) {
					node.textContent = body;
					continue;
				}
				for (const ch of body) {
					node.textContent += ch;
					scrollRoll();
					await sleep(ch === ' ' ? CHAR * 0.6 : CHAR);
				}
			}
			return { cursor, changed };
		}

		// Backgrounds arrive after the line is written, left to right, pulling the eye
		// back across the words that changed.
		async function sweep(changed) {
			for (const span of changed) {
				await sleep(reduced ? 0 : span.textContent.length * CHAR * 0.5);
				span.classList.add('hl');
				await sleep(reduced ? 0 : 90);
			}
		}

		async function retire(cursor) {
			cursor.classList.remove('blinking');
			await sleep(reduced ? 0 : 140);
			cursor.remove();
		}

		async function runPair(entry) {
			const minus = await typeLine('−', 't-minus', entry.minus, 'tw-red');
			await sleep(reduced ? 0 : 280);
			await sweep(minus.changed);
			await retire(minus.cursor);
			await sleep(reduced ? 200 : 850);

			const plus = await typeLine('+', 't-plus', entry.plus, 'tw-green');
			await sleep(reduced ? 0 : 280);
			await sweep(plus.changed);
			await retire(plus.cursor);

			addLine('t-blank');
			await sleep(reduced ? 900 : 3600);
		}

		(async () => {
			await sleep(1400);
			// Work through the ones not already on screen, then the whole set forever.
			for (const entry of rest) await runPair(entry);
			for (let i = 0; ; i++) await runPair(all[i % all.length]);
		})();
	})();
</script>

<style is:global>
	.ticker {
		position: relative;
		/* Above the banner, so lines carry on up into its faded bottom instead of
		   stopping at its edge. The mask below is what thins them out, so nothing
		   is painted over the image. */
		z-index: 3;
		width: 100%;
		/* Overlap the banner's tail, where it has already gone almost entirely to
		   page background, so the lines run up into it. */
		margin: -62px 0 2.6em;
	}

	.ticker-viewport {
		position: relative;
		width: 100%;
		height: 400px;
		overflow: hidden;
		/* The type fades out rather than being covered up. */
		-webkit-mask-image: linear-gradient(
			to bottom,
			transparent 0%,
			rgba(0, 0, 0, 0.15) 10%,
			rgba(0, 0, 0, 0.45) 18%,
			rgba(0, 0, 0, 0.78) 26%,
			#000 34%
		);
		mask-image: linear-gradient(
			to bottom,
			transparent 0%,
			rgba(0, 0, 0, 0.15) 10%,
			rgba(0, 0, 0, 0.45) 18%,
			rgba(0, 0, 0, 0.78) 26%,
			#000 34%
		);
		/* The script adds lines and trims them off the top as it runs. Without
		   these the browser treats that churn as content shifting under the
		   reader and nudges the page scroll to compensate, which reads as the
		   ticker dragging the page down. */
		overflow-anchor: none;
		contain: layout paint;
	}

	.ticker-roll {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		overflow-anchor: none;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		transition: transform 0.6s ease;
	}

	.ticker .t-line {
		display: flex;
		align-items: baseline;
		min-height: 36px;
		flex-shrink: 0;
	}

	/* The marker stays monospace so the two columns line up like a diff. */
	.ticker .t-marker {
		width: 26px;
		min-width: 26px;
		padding-right: 10px;
		text-align: right;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 16px;
		font-weight: 700;
		line-height: 1.4;
	}
	.ticker .t-minus .t-marker { color: var(--accent); }
	.ticker .t-plus .t-marker { color: var(--teal); }

	/* These are headlines, so they are set like headlines. */
	.ticker .t-text {
		flex: 1;
		font-family: var(--font-serif);
		font-size: 20px;
		line-height: 1.4;
		color: var(--ink);
		overflow-wrap: anywhere;
	}

	.ticker .t-blank { min-height: 22px; }

	/* Colour lands only on the words that differ between the two lines. */
	.ticker .tw-red,
	.ticker .tw-green {
		border-radius: 2px;
		padding: 0 3px;
		background: transparent;
		transition: background 0.3s ease;
	}
	.ticker .tw-red { color: var(--accent); }
	.ticker .tw-green { color: var(--teal); }
	.ticker .tw-red.hl { background: var(--red-bg); }
	.ticker .tw-green.hl { background: var(--green-bg); }

	.ticker .t-what {
		position: absolute;
		/* Clear of the banner: the section itself starts 62px up inside it. */
		top: 74px;
		right: 0;
		z-index: 6;
		border: 1px solid var(--border2);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg) 80%, transparent);
		color: var(--ink3);
		font-family: var(--font-sans);
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.4em 0.9em;
		cursor: help;
		transition: color 0.15s, border-color 0.15s;
	}
	.ticker .t-what:hover,
	.ticker .t-what:focus-visible {
		color: var(--ink);
		border-color: var(--accent);
	}

	.ticker .t-explainer {
		position: absolute;
		top: 112px;
		right: 0;
		z-index: 6;
		width: min(30em, 100%);
		background: var(--bg2);
		border: 1px solid var(--bg3);
		border-radius: 4px;
		padding: 1.1em 1.25em;
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18);
	}
	.ticker .t-explainer p {
		font-family: var(--font-sans);
		font-size: 14.5px;
		line-height: 1.6;
		color: var(--ink2);
		margin: 0 0 0.7em;
	}
	.ticker .t-explainer p:last-child {
		margin-bottom: 0;
	}

	/* Hold the lines still and step them back while the explainer is up. */
	.ticker.explaining .ticker-roll {
		opacity: 0.35;
		transition: opacity 0.2s;
	}

	.ticker .t-cursor {
		display: inline-block;
		width: 9px;
		height: 0.9em;
		margin-left: 2px;
		vertical-align: -0.05em;
		background: var(--ink3);
	}
	.ticker .t-cursor.blinking { animation: tcblink 0.65s step-end infinite; }
	@keyframes tcblink {
		0%, 100% { opacity: 1; }
		50% { opacity: 0; }
	}

	@media (max-width: 700px) {
		.ticker-viewport { height: 360px; }
		.ticker .t-text { font-size: 17px; }
		.ticker .t-marker { width: 20px; min-width: 20px; padding-right: 7px; font-size: 14px; }
	}

	@media (prefers-reduced-motion: reduce) {
		.ticker-roll { transition: none; }
		.ticker .t-cursor.blinking { animation: none; }
	}
</style>
