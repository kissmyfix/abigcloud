---
const today = new Date();
const REPO = 'https://github.com/kissmyfix/abigcloud';
---

<footer>
	<p>
		&copy; {today.getFullYear()} abigcloud.com. Original writing released under{' '}
		<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener"
			>CC BY 4.0</a
		>. Source documents are public records.
	</p>
	<p class="repo-note">
		Every citation opens the actual document. They are all listed at{' '}
		<a href="/sources/">Sources</a>. Check it yourself.&nbsp;<a href={REPO} target="_blank" rel="noopener" class="repo-icon"
			aria-label="Every source document, in the repository on GitHub">
			<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18" astro-icon="social/github"
				><path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path></svg
			>
		</a>
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 2.25em 1em;
		background: var(--bg2);
		border-top: 1px solid var(--border);
		color: var(--ink3);
		text-align: center;
		font-size: 0.8em;
	}
	footer p {
		max-width: 44em;
		margin: 0 auto 0.5em auto;
	}
	.repo-note {
		color: var(--ink3);
		/* Wider than the copyright line above it: this sentence plus the inline
		   repo icon runs a little past 44em and the icon was wrapping to a line
		   of its own, which read as an orphan rather than as punctuation. */
		max-width: 48em;
	}
	/* The repo link sits inline at the end of the sentence rather than in its own
	   centred row, so the last line reads between two links: the sources index and
	   the repository the documents live in. Brandon's call, 2026-08-20. */
	.repo-icon {
		display: inline-block;
		vertical-align: -0.28em;
		margin-left: 0.15em;
		text-decoration: none;
		color: var(--ink3);
	}
	@media (hover: hover) {
		.repo-icon:hover {
			color: var(--accent);
		}
	}
</style>

<script is:inline>
	/* Stop the floating Top and Contents pills before they reach the footer.
	   They are position:fixed, so without this they ride the viewport all the way
	   down and sit on top of the footer's repo link once you reach the bottom.
	   Centring them in this same session is what created the collision: the icon
	   is centred too, so they land exactly on it.

	   One variable does the work. Every floating element reads --footer-lift in
	   its own `bottom` calc, so this sets one property and the pills and the
	   contents drawer all rise together. */
	(() => {
		const footer = document.querySelector('footer');
		if (!footer) return;
		const root = document.documentElement;
		let queued = false;
		const apply = () => {
			queued = false;
			const overlap = window.innerHeight - footer.getBoundingClientRect().top;
			root.style.setProperty('--footer-lift', overlap > 0 ? overlap + 'px' : '0px');
		};
		const sync = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(apply);
		};
		sync();
		addEventListener('scroll', sync, { passive: true });
		addEventListener('resize', sync);
	})();
</script>
