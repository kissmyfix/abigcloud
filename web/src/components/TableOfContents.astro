---
/*
 * Contents drawer: a floating button that scrolls with the page, opening a
 * panel that slides up centred over the column. Carried forward from the
 * original single-page abigcloud.com, which used the same shape.
 *
 * Why this and not a sidebar rail: a fixed rail has to be positioned against
 * something. Against the viewport it drifts away from the text; against the
 * measure it needs ~1400px before it stops crowding; over a full-bleed banner
 * it is unreadable. A centred drawer is anchored to nothing, so it collides
 * with nothing, and it behaves identically at every width.
 *
 * Long-form stays on one page: pagination breaks in-page search, splits the
 * URL a reader would cite, and hides how much evidence there is. Navigation is
 * what makes the length tolerable.
 *
 * Opt in per page with `toc: true` in frontmatter.
 */
---

<div class="reading-progress" aria-hidden="true"><span></span></div>

<button id="toc-button" type="button" aria-expanded="false" aria-controls="toc-drawer" hidden>
	<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
		<path d="M4 6h16M4 12h16M4 18h10" fill="none" stroke="currentColor"
			stroke-width="2" stroke-linecap="round"></path>
	</svg>
	<span>Contents</span>
</button>

<div class="toc-drawer" id="toc-drawer" hidden>
	<nav class="toc-drawer-inner" aria-label="Table of contents">
		<p class="toc-drawer-label">Contents</p>
		<ol></ol>
	</nav>
</div>

<script is:inline>
	// This component renders above <main>, so the article does not exist yet when
	// the tag is parsed. Wait for the document before looking for it.
	document.addEventListener('DOMContentLoaded', () => {
		const prose = document.querySelector('.prose');
		const drawer = document.getElementById('toc-drawer');
		const btn = document.getElementById('toc-button');
		if (!prose || !drawer || !btn) return;

		const list = drawer.querySelector('ol');
		// the deck is an h2 too, so skip anything long enough to be a sentence
		const headings = [...prose.querySelectorAll('h2[id], h3[id]')].filter(
			(h) => h.textContent.trim().length < 80,
		);
		if (headings.length < 3) return;

		btn.hidden = false;
		drawer.hidden = false;

		for (const h of headings) {
			const li = document.createElement('li');
			li.className = h.tagName === 'H3' ? 'lvl-3' : 'lvl-2';
			const a = document.createElement('a');
			a.href = '#' + h.id;
			a.textContent = h.textContent.trim();
			li.append(a);
			list.append(li);

			const anchor = document.createElement('a');
			anchor.className = 'heading-anchor';
			anchor.href = '#' + h.id;
			anchor.setAttribute('aria-label', 'Link to this section');
			anchor.textContent = '#';
			h.append(anchor);
		}

		const links = [...list.querySelectorAll('a')];
		const close = () => {
			drawer.classList.remove('open');
			btn.classList.remove('active');
			btn.setAttribute('aria-expanded', 'false');
		};
		btn.addEventListener('click', () => {
			const open = drawer.classList.toggle('open');
			btn.classList.toggle('active', open);
			btn.setAttribute('aria-expanded', String(open));
		});
		list.addEventListener('click', close);
		addEventListener('keydown', (e) => e.key === 'Escape' && close());
		// a click anywhere off the panel closes it
		addEventListener('click', (e) => {
			if (!drawer.classList.contains('open')) return;
			if (drawer.contains(e.target) || btn.contains(e.target)) return;
			close();
		});

		// scrollspy
		const seen = new Map();
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) seen.set(e.target.id, e.isIntersecting);
				const visible = headings.filter((h) => seen.get(h.id));
				if (!visible.length) return;
				for (const a of links) a.classList.toggle('current', a.hash === '#' + visible[0].id);
			},
			{ rootMargin: '-10% 0px -70% 0px' },
		);
		for (const h of headings) io.observe(h);

		// the button appears on the same trigger as Top, so they arrive together
		const sync = () => btn.classList.toggle('visible', window.scrollY > 600);
		sync();
		addEventListener('scroll', sync, { passive: true });

		// progress across the article body, not the whole document
		const bar = document.querySelector('.reading-progress span');
		const update = () => {
			const span = prose.offsetHeight - window.innerHeight;
			const done = span > 0 ? (window.scrollY - prose.offsetTop) / span : 0;
			bar.style.transform = `scaleX(${Math.min(1, Math.max(0, done))})`;
		};
		update();
		addEventListener('scroll', update, { passive: true });
		addEventListener('resize', update);
	});
</script>
